# Copy to .env.local for local development. Every value is optional in
# development; without DATABASE_URL the app uses an embedded Postgres (PGlite)
# stored in .data/pglite.

# Real Postgres connection string. REQUIRED in production (the app refuses to
# start without it). Use a pooled/serverless-friendly provider such as Neon.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Closed beta: when set, creating a workspace requires this code. Leave unset
# to keep signup open.
# SIGNUP_INVITE_CODE=choose-a-beta-code
